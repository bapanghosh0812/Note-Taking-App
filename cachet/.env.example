# PostgreSQL connection string.
# Local:  postgres://cachet:cachet@localhost:5433/cachet   (npm run db:local)
# Neon:   postgres://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Public origin of the app, used to build share links and for CSRF origin checks.
APP_URL=http://localhost:3000

# Random secret (min 32 chars) used to HMAC client IPs before storing them.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# Optional — enables the AI assistant (Google Gemini). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional — override the Gemini model.
GEMINI_MODEL=gemini-3.8-flash

# Optional — enables the daily cleanup job (/api/cron/cleanup). Any random string, 16+ chars.
CRON_SECRET=

# Optional — used by `npm run db:seed` to create a demo account.
DEMO_EMAIL=demo@cachet.app
DEMO_PASSWORD=
